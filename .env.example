# Copy to .env.local for local development, and add the same names in Vercel's project settings
# (Settings > Environment Variables). Never commit real values.

# Resend (contact form). Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# The sender, on a domain you've verified in Resend. Until then, leave it empty to use Resend's
# test sender, which only delivers to the email address on your Resend account.
CONTACT_FROM="Product Paige <hello@productpaige.com>"
# Where enquiries go (defaults to the site's email)
CONTACT_TO=
# (CONTACT_TO_EMAIL also works, for the name already set in Vercel)
